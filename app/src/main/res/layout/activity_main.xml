<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OCE ROSEMARY"
        android:textColor="#00FF66"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRootStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Root: Checking..."
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#333333" />

    <!-- CPU Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CPU TELEMETRY (MT6785)"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCpuLittle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:text="LITTLE Cores: -- MHz"
        android:textColor="#00E5FF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvCpuBig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:text="BIG Cores: -- MHz"
        android:textColor="#FF9100"
        android:textSize="16sp" />

    <!-- GPU Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="GPU TELEMETRY (Mali-G76)"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGpuFreq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:text="GPU Freq: -- MHz"
        android:textColor="#FF0055"
        android:textSize="16sp" />

</LinearLayout>
